<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    <section class="min-vh-100 d-flex align-items-center justify-content-center"
        style="background-color: rgb(24, 83, 202);">
        <div class="card shadow-sm overflow-hidden border-0" style="width: 100%; max-width: 900px;">
            <%- include('partials/alert')%>
                <div class="row g-0">
                    <div class="col-md-6 d-none d-md-flex align-items-center justify-content-center p-0"
                        style="background-color: #000;">
                        <img src="/images/logo/LOGORUBICAMP.jpg" alt="Rubicamp" class="img-fluid w-100">
                    </div>

                    <div class="col-md-6 bg-white">
                        <div class="p-4 p-md-5">
                            <div class="text-center">
                                <h1 class="fs-2">Point of Sales</h1>
                                <hr>
                                <h2 class="fs-5 mt-4">Welcome Back!</h2>
                            </div>
                            <form action="/login" method="post" class="mt-4">
                                <div class="mb-3">
                                    <label for="email" class="visually-hidden">Email</label>
                                    <input class="form-control rounded-pill" type="email" name="email"
                                        placeholder="Email address">
                                </div>
                                <div class="mb-3">
                                    <label for="password" class="visually-hidden">Password</label>
                                    <input class="form-control rounded-pill" type="password" name="password"
                                        placeholder="Password">
                                </div>
                                <div class="form-check mb-3" style="color: rgb(106, 106, 106);">
                                    <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault">
                                    <label class="form-check-label" for="flexCheckDefault">
                                        Remember Me
                                    </label>
                                </div>
                                <button class="btn btn-primary w-100 rounded-pill" type="submit">Login</button>
                                <hr>
                            </form>
                                <p class="text-center mb-1"><a href="/register" class="text-decoration-none">Forgot Password?</a></p>
                        </div>
                    </div>
                </div>
        </div>
    </section>
</body>

</html>